{
	"name": "@nerd-coder/aws-nitro-enclaves-nsm-api-ts",
	"version": "0.1.0",
	"description": "Node.js bindings for the AWS Nitro Enclaves NSM API, implemented in Rust using N-API.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"repository": "github:nerd-coder/aws-nitro-enclaves-nsm-api-ts",
	"license": "Apache-2.0",
	"keywords": [
		"napi-rs",
		"NAPI",
		"N-API",
		"Rust",
		"node-addon",
		"node-addon-api",
		"aws-nitro-enclaves-nsm-api"
	],
	"files": [
		"dist/index.js",
		"dist/index.d.ts"
	],
	"napi": {
		"binaryName": "aws-nitro-enclaves-nsm-api",
		"targets": [
			"x86_64-pc-windows-msvc",
			"x86_64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu",
			"aarch64-apple-darwin"
		]
	},
	"engines": {
		"node": ">= 18.17.0 < 19 || >= 20.3.0 < 21 || >= 21.1.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"scripts": {
		"artifacts": "napi artifacts --output-dir ./dist",
		"build": "napi build --platform --release --esm --output-dir=./dist",
		"build:debug": "napi build --platform --esm --output-dir=./dist",
		"check": "bun run lint && bun run build && bun run smoke",
		"lint": "cargo fmt -- --check && cargo clippy --all-targets --all-features -- -D warnings",
		"prepublishOnly": "napi pre-publish -t npm",
		"preversion": "napi build --platform && git add .",
		"smoke": "node -e \"await import('./dist/index.js')\"",
		"test": "bun run smoke",
		"version": "napi version"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.2.0"
	},
	"packageManager": "bun@1.3.14",
	"optionalDependencies": {
		"@nerd-coder/aws-nitro-enclaves-nsm-api-ts-win32-x64-msvc": "0.1.0",
		"@nerd-coder/aws-nitro-enclaves-nsm-api-ts-darwin-x64": "0.1.0",
		"@nerd-coder/aws-nitro-enclaves-nsm-api-ts-linux-x64-gnu": "0.1.0",
		"@nerd-coder/aws-nitro-enclaves-nsm-api-ts-linux-arm64-gnu": "0.1.0",
		"@nerd-coder/aws-nitro-enclaves-nsm-api-ts-darwin-arm64": "0.1.0"
	}
}
